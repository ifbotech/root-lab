# Copiar a .env. Ninguna es obligatoria para desarrollar.

# PORT=8080

# A donde lleva el QR del emulador y los enlaces de los emails. Por defecto,
# la IP de esta compu. Para probar instalacion y notificaciones en un telefono:
# la URL de un tunel HTTPS.
# ROOTLAB_URL_PUBLICA=https://algo.trycloudflare.com

# Clave maestra: cifra emails, nombres y charlas, y es la pimienta de las
# contrasenas. 32 bytes en base64 (openssl rand -base64 32). Sin ella, en
# desarrollo se crea data/secreto.key. En produccion es obligatoria y NO se
# pierde: ver docs/seguridad.md.
# ROOTLAB_SECRETO=

# IA: reconocer y diagnosticar por foto, y el chat con la planta.
# Sin clave, todo es simulado. Ver docs/ia.md.
# ANTHROPIC_API_KEY=
# ROOTLAB_IA_MODELO=claude-opus-5
# ROOTLAB_IA_MODELO_CHAT=claude-sonnet-5
# Tope de gasto global, en dolares (0 = sin tope).
# ROOTLAB_IA_TOPE_DIA_USD=2
# ROOTLAB_IA_TOPE_MES_USD=20
# Cuotas del plan gratis, por dia.
# ROOTLAB_CUOTA_CHAT=3
# ROOTLAB_CUOTA_IDENTIFICAR=3
# ROOTLAB_CUOTA_DIAGNOSTICAR=2
# Precios en USD por millon de tokens, si cambian (JSON).
# ROOTLAB_IA_PRECIOS={"claude-sonnet-5":{"entrada":3,"salida":15}}

# Correo: recuperar la contrasena y verificar el email. Ver docs/correo.md.
# Sin SMTP, cada email queda como .eml en data/correos.
# ROOTLAB_SMTP_HOST=smtp-relay.brevo.com
# ROOTLAB_SMTP_PORT=587
# ROOTLAB_SMTP_USUARIO=
# ROOTLAB_SMTP_CLAVE=
# ROOTLAB_CORREO_REMITENTE=ROOTLAB <no-reply@tu-dominio.com>
# A quien avisar cuando la IA se acerca al tope de gasto.
# ROOTLAB_ADMIN_EMAIL=

# Pronostico (Open-Meteo, sin clave): anticipa el riego con el clima que
# viene. Lo unico que sale del servidor es la ciudad que escribio la persona.
# ROOTLAB_CLIMA=1

# 0 en produccion: rechaza aparatos que no registro la fabrica.
# ROOTLAB_TOFU=1

# ROOTLAB_DATOS=data
# ROOTLAB_CONTACTO=https://github.com/ifbotech/root-lab
