# Copiar a .env. Ninguna es obligatoria para desarrollar.

# PORT=8080

# A donde lleva el QR del emulador. Por defecto, la IP de esta compu.
# Para probar instalacion y notificaciones en un telefono: la URL de un tunel HTTPS.
# ROOTLAB_URL_PUBLICA=https://algo.trycloudflare.com

# Identificacion y diagnostico con Claude. Sin clave, la IA es simulada.
# ANTHROPIC_API_KEY=
# ROOTLAB_IA_MODELO=claude-opus-5

# 0 en produccion: rechaza aparatos que no registro la fabrica.
# ROOTLAB_TOFU=1

# ROOTLAB_DATOS=data
# ROOTLAB_CONTACTO=https://github.com/ifbotech/root-lab
