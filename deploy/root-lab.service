# root-lab como servicio de systemd.
#
#   sudo cp deploy/root-lab.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now root-lab
#   journalctl -u root-lab -f
#
# Corre con su propio usuario sin privilegios, sólo puede escribir en su
# carpeta de datos y escucha únicamente en 127.0.0.1: al mundo sale por el
# Caddy del servidor, con HTTPS.

[Unit]
Description=root-lab: la app y la nube de ROOTKIT
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rootlab
Group=rootlab
WorkingDirectory=/opt/root-lab
EnvironmentFile=/etc/root-lab.env
# Node propio (deploy/instalar.sh): el del sistema puede ser más viejo.
ExecStart=/opt/root-lab-node/bin/node --disable-warning=ExperimentalWarning server/index.mjs
Restart=always
RestartSec=3

# Endurecimiento: nada fuera de su carpeta de datos, sin escalar privilegios,
# sin capacidades del kernel y con archivos nuevos privados (umask 077).
# `systemd-analyze security root-lab` da el puntaje.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/root-lab
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
