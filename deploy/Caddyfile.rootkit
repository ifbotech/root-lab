# El Caddyfile del VPS: ifbotech.com con ROOTLAB en /rootkit.
#
# Lo de ROOTLAB va ANTES de lo que manda todo lo demás a la app principal:
# `handle` es excluyente, lo que entra acá no llega al resto.
#
# El matcher no distingue mayúsculas porque el QR del firmware va entero en
# mayúsculas (HTTPS://IFBOTECH.COM/ROOTKIT/V/...) para entrar en el modo
# alfanumérico del QR. La base NO se quita: ROOTLAB la recibe y la resuelve
# (server/http.mjs). Las demás cabeceras de seguridad las pone la app.

# La API de administración de Caddy, por un socket en su propia carpeta (750
# caddy) y no en 127.0.0.1:2019, donde cualquier proceso de la máquina podía
# reconfigurar el proxy. Lo pone deploy/endurecer-vps.sh.
{
	admin unix//var/lib/caddy/admin.sock
}

ifbotech.com, www.ifbotech.com {
	tls ifbarnetche@gmail.com

	# HTTPS siempre (un año), y sin anunciar qué servidor es.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
		-X-Powered-By
	}

	# El dashboard viejo de ROOTKIT ahora es ROOTLAB.
	@rootkitViejo path_regexp ^/(?i)rootkit/dashboard(/.*)?$
	redir @rootkitViejo /rootkit/ 302

	@rootkit path_regexp ^/(?i)rootkit(/.*)?$
	handle @rootkit {
		reverse_proxy 127.0.0.1:8090
	}

	# API del dashboard viejo: retirada.
	handle /api/botanist* {
		respond 404
	}

	# La app principal (Next.js en Docker, sólo en 127.0.0.1).
	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
